{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": ".",
  "projects": {
    "beadle-gui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "beadle-gui",
      "sourceRoot": "beadle-gui/src",
      "prefix": "beadle",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "beadle-gui/dist",
              "browser": ""
            },
            "browser": "beadle-gui/src/main.ts",
            "index": "beadle-gui/src/index.html",
            "tsConfig": "beadle-gui/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "beadle-gui/public"
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/@v6/v6-icons/assets/icons",
                "output": "./@v6/v6-icons/assets/icons"
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/@v6/v6-icons/assets/icons",
                "output": "./~@v6/v6-icons/assets/icons"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/ag-grid-community/styles/ag-grid.css",
              "node_modules/ag-grid-community/styles/ag-theme-balham.css",
              "node_modules/@v6/v6-table/assets/v6-table-theme--bbh.min.css",
              "node_modules/@v6/v6-themes/styled-elements/main.min.css",
              "node_modules/@v6/v6-themes/jersey-theme.min.css",
              "node_modules/@angular/cdk/overlay-prebuilt.css",
              "node_modules/@angular/cdk/a11y-prebuilt.css",
              "beadle-gui/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "beadle-gui:build:production"
            },
            "development": {
              "buildTarget": "beadle-gui:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "beadle-gui/proxy.conf.json",
            "port": 4201
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "beadle-gui/tsconfig.spec.json",
            "runnerConfig": true,
            "coverageReporters": [
              "text-summary",
              "html",
              "lcov"
            ],
            "coverageExclude": [
              "beadle-gui/src/**/*.spec.ts",
              "beadle-gui/src/**/*.d.ts",
              "beadle-gui/src/app/testing/**",
              "beadle-gui/src/test-providers.ts"
            ],
            "coverageThresholds": {
              "statements": 60,
              "lines": 60
            },
            "coverageInclude": [
              "beadle-gui/src/**/*.ts"
            ],
            "buildTarget": "beadle-gui:build:development",
            "providersFile": "beadle-gui/src/test-providers.ts"
          }
        }
      }
    }
  }
}
